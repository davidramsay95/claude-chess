{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-chess",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "claude-chess.com", "custom_domain": true }],
  "vars": { "BETTER_AUTH_URL": "https://claude-chess.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-chess",
      "database_id": "489494dc-c18e-48b3-a096-27d543d36f9f",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
