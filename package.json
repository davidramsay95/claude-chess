{
  "name": "claude-chess",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:games": "node scripts/build-games.ts",
    "build:shell": "npm --prefix apps/shell run build",
    "build": "npm run build:games && npm run build:shell",
    "build:ci": "npm --prefix worker ci && npm --prefix apps/shell ci && npm run build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.0.0"
  }
}
